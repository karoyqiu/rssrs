{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.gmail.karoyqiu.rssrs",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "RSS",
        "width": 1200,
        "height": 700,
        "center": true,
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "style-src": [
          "'self'",
          "'nonce-rWvh_Hd30vNJfto7tl9ve'",
          "'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='",
          "'sha256-qixoDh78J8vISHKC3rLI7qSXmTShr8mhsUgjJL7W7aU='",
          "'sha256-3gJFr3n77fnX5qwQpGju/zCOsoHW5RMqQd5XOb9WFcA='",
          "'sha256-K/NeD53vB+5+2jizTdfGGkVkvm4CMfXJ5UTuQOzO8sY='"
        ],
        "connect-src": ["ipc: http://ipc.localhost"],
        "img-src": ["'self'", "https:", "data:"],
        "default-src": ["'self'"]
      }
    }
  }
}
